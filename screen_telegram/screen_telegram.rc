// screen_telegram.rc - exe 파일 속성(자세히 탭)에 표시되는 버전 정보. UTF-8 로 저장할 것.
// 빌드: windres -c 65001 -I. -O coff -i screen_telegram.rc -o screen_telegram_res.o  (build.bat 이 수행)
#pragma code_page(65001)

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"   // 한국어(0x0412), Unicode(0x04B0)
        BEGIN
            VALUE "CompanyName",      APP_COMPANY
            VALUE "FileDescription",  "Screen Telegram"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "screen_telegram"
            VALUE "LegalCopyright",   APP_COPYRIGHT
            VALUE "OriginalFilename", "screen_telegram.exe"
            VALUE "ProductName",      "screen_telegram"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
